                  ItemEspecificacion(icono: Icons.speed, titulo: 'BALANCE', valor: 'Alto', colorFondo: Color(0xFFFFF8E1), colorIcono: Colors.orange),
                  ItemEspecificacion(icono: Icons.bolt, titulo: 'NÚCLEO', valor: 'HR3 EVA', colorFondo: Color(0xFFE8F5E9), colorIcono: Colors.green),
                ],
              ),
              const SizedBox(height: 32),
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  const Text(
                    'Historial de precio',
                    style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
                  ),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                    decoration: BoxDecoration(
                      color: const Color(0xFFE8F5E9),
