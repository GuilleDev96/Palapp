    int ahorro = precioAntiguoInt > precioActualInt ? precioAntiguoInt - precioActualInt : 0;

    return Scaffold(
      backgroundColor: Colors.white,
      appBar: AppBar(
        backgroundColor: Colors.white,
        elevation: 0,
        scrolledUnderElevation: 0,
